APP_NAME="Happy Journy TukTuk Rental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuktuk_rental
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mirandatuktuk.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Application-specific settings (see docs/01-architecture.md) ---
ADMIN_PATH=control-panel
BUSINESS_TIMEZONE=Asia/Colombo
DEFAULT_CURRENCY=USD

# Online payment is OFF by default — this is a new business taking
# pay-on-pickup only for now. The Payment module (Phase 6) is built in
# full but stays hidden from checkout until this is flipped to true and
# real gateway keys are set.
PAYMENT_ONLINE_ENABLED=false

BOOKING_HOLD_MINUTES=15
AVAILABILITY_BUFFER_DAYS=0
AVAILABILITY_MIN_NOTICE_HOURS=4
AVAILABILITY_MAX_ADVANCE_DAYS=365
AVAILABILITY_DAILY_PICKUP_CAPACITY=10

BUSINESS_PHONE="+94 00 000 0000"
BUSINESS_WHATSAPP=94000000000
BUSINESS_EMAIL=hello@mirandatuktuk.example
BUSINESS_ADDRESS="[Address pending]"
BUSINESS_CITY=Negombo

# "New booking" email to staff — comma-separated; empty = BUSINESS_EMAIL.
# It is queued: run a worker (`php artisan queue:work`) for it to send.
BOOKING_ADMIN_NOTIFICATION_EMAILS=
BOOKING_NOTIFICATION_QUEUE=default
BOOKING_MAX_RENTAL_DAYS=180

TWO_FACTOR_ENFORCED_ROLES="Super Admin"

ADMIN_IP_ALLOWLIST_ENABLED=false
ADMIN_IP_ALLOWLIST=

ADMIN_SESSION_IDLE_MINUTES=20
ADMIN_SESSION_ABSOLUTE_HOURS=8
